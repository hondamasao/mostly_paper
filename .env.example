# Copy this file to ".env" and fill in real values. Never commit ".env".
# All values below are placeholders.

# --- Stripe (payments) -------------------------------------------------
# Dashboard > Developers > API keys > Secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...)
# Endpoint URL: https://YOUR_DOMAIN/api/webhook, event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# --- Printful (print-on-demand fulfillment) ----------------------------
# Printful dashboard > Settings > API > create a token
PRINTFUL_API_KEY=

# --- Site ---------------------------------------------------------------
# Public URL of the deployed site, no trailing slash. REQUIRED in production:
# Stripe sends customers back to this URL after paying. If unset it falls
# back to http://localhost:3000, which breaks the post-payment redirect.
YOUR_DOMAIN=https://your-domain.example
# Port the Node server listens on (most hosts set this automatically)
PORT=3000

# --- Optional: email alert when an ORIGINAL painting sells -------------
# Resend (resend.com) API key. If empty, originals are only logged to the
# server console and nobody is emailed.
RESEND_API_KEY=
# Where the alert is sent. Defaults to hello@mostly-paper.com if unset.
JASON_EMAIL=
